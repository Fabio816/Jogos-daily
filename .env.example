# TMDB (The Movie Database)
# Crie um token de leitura em https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=seu_token_de_leitura_tmdb_aqui
TMDB_API_KEY=sua_api_key_tmdb_aqui

# Twitch / IGDB
# Crie um app em https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=seu_client_id_twitch_aqui
TWITCH_CLIENT_SECRET=seu_client_secret_twitch_aqui

# Firebase (configuração pública do app web)
# Console do Firebase > Configurações do projeto > Seus apps
VITE_FIREBASE_API_KEY=sua_api_key_firebase_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://seu-projeto-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id_aqui
VITE_FIREBASE_APP_ID=seu_app_id_aqui

# Mapillary
# Crie um token em https://www.mapillary.com/dashboard/developers
VITE_MAPTILER_KEY=sua_chave_maptiler_aqui
VITE_MAPILLARY_TOKEN=seu_token_mapillary_aqui
VITE_MAPILLARY_CLIENT=seu_client_mapillary_aqui
VITE_MAPILLARY_AUTHORIZATION=https://www.mapillary.com/connect?client_id=seu_client_id_aqui
