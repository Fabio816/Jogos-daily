{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt"
      ],
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "termo": {
      "rooms": {
        ".read": "auth != null",
        ".indexOn": [
          "createdAt"
        ],
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "bomb": {
      "rooms": {
        ".read": "auth != null",
        ".indexOn": [
          "createdAt"
        ],
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "onde": {
      "rooms": {
        ".read": "auth != null",
        ".indexOn": [
          "createdAt"
        ],
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "alerts": {
      "$game": {
        "$code": {
          ".read": "auth != null",
          "$alertId": {
            ".write": "auth != null && newData.child('uid').val() === auth.uid"
          }
        }
      }
    },
    "ranking": {
      ".read": "auth != null",
      ".indexOn": [
        "points"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
